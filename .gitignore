# Rust build artifacts
/target/
**/*.rs.bk

# Cargo (keep Cargo.lock for the workspace; it has binaries)
# (Cargo.lock is intentionally committed for reproducible binary builds)

# Generated uniffi bindings (reproducible artifact; see bindings/README.md)
/crates/client-core/bindings/swift/
/crates/client-core/bindings/kotlin/

# Android JNI libs (reproducible via scripts/build-android.ps1)
/clients/android/app/src/main/jniLibs/

# Android release signing — NEVER commit these
/clients/android/*.jks
/clients/android/keystore.properties

# Android build output
/clients/android/.gradle/
/clients/android/app/build/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/
