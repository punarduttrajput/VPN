# Normalize line endings. Shell scripts MUST stay LF so they run on Linux
# runners even when authored/checked out on Windows.
* text=auto
# Vendored native libraries (e.g. wintun.dll) are binary — never EOL-normalize.
*.dll binary
*.jar binary
# Pinned digests for the above (SEC-008): `sha256sum -c` needs LF paths.
vendor/SHA256SUMS text eol=lf
*.sh text eol=lf
*.rs text
*.toml text
*.md text
*.yml text eol=lf
