[Unit]
Description=Ferrum VPN privileged helper (TUN + kill-switch, Phase 5)
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ferrum-helper --socket /run/ferrum/helper.sock --group ferrum
# Creates and owns /run/ferrum (mode 0750, root:root) before ExecStart; the
# daemon itself chowns the socket inside it to the `ferrum` group.
RuntimeDirectory=ferrum
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
