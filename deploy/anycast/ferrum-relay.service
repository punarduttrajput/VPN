[Unit]
Description=Ferrum relay on the anycast address
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Bind the anycast address itself, not 0.0.0.0: replies must come from the
# address clients sent to, or their transport drops them (see README.md).
# With more than one PoP, mesh the relays so peers on different PoPs can
# relay to each other (PRD/relay-mesh.md), and let the coordinator distribute
# the membership. Add, with this PoP's unicast address:
#   --coordinator http://coordinator.internal:50051
#   --advertise 192.0.2.10:51821
#   --mesh-listen 198.51.100.10:51822 --mesh-key-file /etc/ferrum/mesh.key
# (plus --token-file if the coordinator uses OIDC), and LoadCredential= or
# ReadOnlyPaths= for the key files as your setup needs. Without a mesh, leave
# these out and give the coordinator a static --relay 192.0.2.10:51821.
ExecStart=/usr/local/bin/ferrum relay \
    --listen 192.0.2.10:51821 \
    --metrics-listen 127.0.0.1:9101 \
    --drain-grace 20
# SIGTERM starts the drain; give it the grace window plus some slack before
# systemd escalates to SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=2

DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
