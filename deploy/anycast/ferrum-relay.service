[Unit]
Description=Ferrum relay on the anycast address
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Bind the anycast address itself, not 0.0.0.0: replies must come from the
# address clients sent to, or their transport drops them (see README.md).
# No --coordinator/--advertise: with anycast the coordinator advertises the
# anycast address statically (`ferrum-coordinator --relay 192.0.2.10:51821`).
# With more than one PoP, mesh the relays so peers on different PoPs can
# relay to each other (PRD/relay-mesh.md): add, with this PoP's unicast
# address and one --mesh-peer per other PoP,
#   --mesh-listen 198.51.100.10:51822 --mesh-key-file /etc/ferrum/mesh.key
#   --mesh-peer 203.0.113.20:51822
# and LoadCredential=/ReadOnlyPaths= for the key file as your setup needs.
ExecStart=/usr/local/bin/ferrum relay \
    --listen 192.0.2.10:51821 \
    --metrics-listen 127.0.0.1:9101 \
    --drain-grace 20
# SIGTERM starts the drain; give it the grace window plus some slack before
# systemd escalates to SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=2

DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
