# Copy this to .env and fill in the two REPLACE_ME values before first run.

# Public domain for the admin panel (DNS A record -> this VM's public IP), for
# automatic Let's Encrypt HTTPS. Leave blank to access via the raw IP instead
# (Caddy self-signs; your browser will warn once).
DOMAIN=

# The relay's address as reachable from the internet — advertised to every
# device via the network map as their NAT-traversal fallback. Must be the
# VM's public IP (Oracle gives you a fixed one), not a private/internal address.
RELAY_ADVERTISE=REPLACE_ME_WITH_VM_PUBLIC_IP:51821

# Self-issued auth identifiers (PRD Phase 3 OIDC — these are just matching
# labels between scripts/mint-token.py and the coordinator's verifier, not a
# real external identity provider; see README.md). Fine to leave as-is.
OIDC_ISSUER=https://ferrum.internal
OIDC_AUDIENCE=ferrum-admin
